# ==============================================================================
# AI SALES COMMANDER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This is a template file. Do not put actual secrets in here.
# Copy this file to `.env` in the root directory before running docker-compose.

# ------------------------------------------------------------------------------
# [FRONTEND] React / Vite Configuration
# ------------------------------------------------------------------------------
# The API URL the frontend should talk to.
# For local dev: http://localhost:8000
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Meta / WhatsApp / OpenAI public keys if needed by frontend
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ------------------------------------------------------------------------------
# [BACKEND] FastAPI & Security
# ------------------------------------------------------------------------------
# Generate a secret key: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# [DATABASE] PostgreSQL (Supabase / Local)
# ------------------------------------------------------------------------------
# The main PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@host:port/dbname

# ------------------------------------------------------------------------------
# [REDIS] Caching & Celery Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# [AI & LLM] API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ------------------------------------------------------------------------------
# [INTEGRATIONS] External Services
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WhatsApp (Evolution API or Meta)
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_ACCESS_TOKEN=EA...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# AWS (If using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
