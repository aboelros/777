# Root .gitignore for AI Sales Commander

# Environment variables
.env
.env.local
.env.production
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
backend/venv/

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Database
*.db
*.sqlite
*.sqlite3

# Railway
.railway/

# Testing
.pytest_cache/
coverage/
htmlcov/
.coverage

# Build artifacts
*.egg-info/
build/
dist/

# Secrets - never commit these
*.env
!*.env.example
COMPLETE_CONFIG.env
SUPAPASE_CONFIG.env
secret_key.txt

# ============================================================
# SECURITY: Never commit secrets or credentials
# ============================================================
COMPLETE_CONFIG.env
SUPABASE_CONFIG.env
secret_key.txt
backend/secret_key.txt
# Block all .env files except examples
*.env
!*.env.example
!*.env.example.*
railway.env
RAILWAY.env

# Temporary scratch and debug artifacts
backend/debug_test.py
backend/error.txt
backend/pytest_output.txt
apply_consume.py
apply_consume_tiktok.py
fix_user_id.py
group5.txt
patch.py
routes_table.md
storage_lines.txt
wa_diagnosis.md
agentic_code_reader/
ai_analysis_*.md
startup-support/

# Media recordings and local test renders
*.mp4
*.png
*.mp3
*.vtt
recordings/
meta_review_videos/
after_effects/
admin-panel/dist/

