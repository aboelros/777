# Root .gitignore for AI Sales Commander

# Environment variables
.env
.env.local
.env.production
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
backend/venv/

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Database
*.db
*.sqlite
*.sqlite3

# Railway
.railway/

# Testing
.pytest_cache/
coverage/
htmlcov/
.coverage

# Build artifacts
*.egg-info/
build/
dist/

# Secrets - never commit these
*.env
!*.env.example
COMPLETE_CONFIG.env
SUPAPASE_CONFIG.env
secret_key.txt

# ============================================================
# SECURITY: Never commit secrets or credentials
# ============================================================
COMPLETE_CONFIG.env
SUPABASE_CONFIG.env
secret_key.txt
backend/secret_key.txt
# Block all .env files except examples
*.env
!*.env.example
!*.env.example.*
railway.env
RAILWAY.env
